{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Yupipi93/eda-wirewright/schema/schematic.schema.json",
  "title": "wirewright schematic contract",
  "description": "Declarative description of a schematic/wiring diagram. The engine auto-routes and DRC-validates it.",
  "type": "object",
  "required": ["canvas", "components", "nets"],
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": {"type": "integer", "minimum": 100},
        "h": {"type": "integer", "minimum": 100},
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "bg": {"$ref": "#/$defs/rgb"}
      }
    },
    "config": {
      "type": "object",
      "description": "Optional engine tunables (flat or nested by section: router/drc/render).",
      "additionalProperties": true
    },
    "rails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "y", "x0", "x1", "color"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "y": {"type": "number"},
          "x0": {"type": "number"},
          "x1": {"type": "number"},
          "color": {"$ref": "#/$defs/color"},
          "label": {"type": "string"},
          "label_x": {"type": ["number", "null"]},
          "width": {"type": "integer", "minimum": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "unique component id, referenced by nets"},
          "type": {"type": "string", "description": "a registered component type (see `wirewright components`)"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "args": {"type": "object", "description": "extra constructor args for the component type"}
        }
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "color", "nodes"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "color": {"$ref": "#/$defs/color"},
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/node"}
          },
          "width": {"type": "integer", "minimum": 1},
          "style": {"enum": ["wire", "label"]},
          "priority": {"type": "integer"}
        }
      }
    },
    "legend": {"type": "object"},
    "notes": {"type": "array"},
    "annotations": {"type": "array"}
  },
  "$defs": {
    "rgb": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}, "minItems": 3, "maxItems": 3},
    "color": {
      "description": "palette name ('led','gnd',…), common name ('red'), '#rrggbb', or [r,g,b]",
      "oneOf": [{"type": "string"}, {"$ref": "#/$defs/rgb"}]
    },
    "node": {
      "description": "['port', comp_id, port] | ['rail', rail_name] | ['point', x, y]",
      "type": "array",
      "minItems": 2,
      "items": {"type": ["string", "number"]}
    }
  }
}
